{
  "manifest_version": 3,
  "name": "Vertical Shooter S-Rank",
  "version": "7.0.0",
  "description": "A browser-based vertical shooter with multilingual UI, dynamic language switching, BGM, and local high score support.",
  "action": {
    "default_title": "Vertical Shooter S-Rank",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "bgm.mp3"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "locales/ja.json",
        "locales/en.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}












